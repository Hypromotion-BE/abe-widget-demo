    {"source":"/","has":[{"type":"query","key":"region","value":"US|us"}],"destination":"/us/","permanent":false},
    {"source":"/index.html","has":[{"type":"query","key":"region","value":"US|us"}],"destination":"/us/","permanent":false},
    {"source":"/gadget-gifts.html","has":[{"type":"query","key":"region","value":"UK|uk"}],"destination":"/uk/gadget-gifts/","permanent":false},
    {"source":"/gadget-gifts.html","has":[{"type":"query","key":"region","value":"EU|eu"}],"destination":"/de/gadget-gifts/","permanent":false},
    {"source":"/gadget-gifts.html","has":[{"type":"query","key":"region","value":"US|us"}],"destination":"/us/gadget-gifts/","permanent":false},
